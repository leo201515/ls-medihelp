<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F9FF">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/gradient_toolbar"
            app:titleTextColor="@android:color/white"
            app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝 Beschreiben Sie Ihre Symptome"
                android:textColor="@color/medical_primary_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ageInfoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ihr Alter: -- Jahre"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:alpha="0.8"
                android:drawableStart="@android:drawable/ic_menu_my_calendar"
                android:drawablePadding="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/medical_primary"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/medical_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/symptomsInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="z.B. headache, fever, cough, Kopfschmerzen..."
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Foto hinzufügen"
                    android:textColor="@color/medical_primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/photoStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Foto ausgewählt"
                        android:textColor="@color/medical_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/badge_background"
                        android:padding="8dp" />

                </FrameLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Fügen Sie ein Foto Ihres Symptoms oder Ihrer Verletzung hinzu"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:alpha="0.7" />

            <androidx.cardview.widget.CardView
                android:id="@+id/photoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/photoPreviewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/photoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/gradient_overlay" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Foto wird mit Ihrer Beratung gespeichert"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:alpha="0.9" />

                        </LinearLayout>

                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/uploadButtonsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cameraButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="📸  Kamera"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:paddingVertical="12dp"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@color/medical_primary"
                            android:textAllCaps="false"
                            app:elevation="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/galleryButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="🖼  Galerie"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:paddingVertical="12dp"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@color/medical_primary"
                            android:textAllCaps="false"
                            app:elevation="4dp" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/removePhotoButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="🗑  Foto entfernen"
                        android:textSize="14sp"
                        android:visibility="gone"
                        app:cornerRadius="12dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeColor="#FF5252"
                        android:textColor="#FF5252"
                        android:textAllCaps="false" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/getAdviceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:onClick="onGetAdvice"
                android:text="🔬  Beratung anfordern"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                android:paddingVertical="16dp"
                app:backgroundTint="@color/medical_secondary"
                app:elevation="8dp"
                android:stateListAnimator="@null" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone"
                android:indeterminateTint="@color/medical_primary"
                android:indeterminateTintMode="src_atop" />

            <androidx.cardview.widget.CardView
                android:id="@+id/adviceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="28sp"
                            android:layout_marginEnd="12dp"
                            android:textColor="@color/medical_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ihre Beratung"
                            android:textColor="@color/medical_primary_dark"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginVertical="16dp"
                        android:background="@drawable/gradient_divider" />

                    <TextView
                        android:id="@+id/adviceOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:lineSpacingExtra="8dp"
                        android:fontFamily="sans-serif-light" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="📋  Verlauf anzeigen"
                android:textSize="14sp"
                android:onClick="onViewHistory"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/medical_primary"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_recent_history"
                app:iconTint="@color/medical_primary"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>